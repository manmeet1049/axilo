# Basic AWS Lambda Dockerfile (Python example)
# Save as "Dockerfile" (this file appears to be named "dockerfile" in your path)
FROM public.ecr.aws/lambda/python:3.9

# Copy application code
# Place your handler function in app.py (def lambda_handler(event, context): ...)
COPY app.py ${LAMBDA_TASK_ROOT}

# Optional: install dependencies if you have requirements.txt
# COPY requirements.txt .
# RUN pip install -r requirements.txt --target "${LAMBDA_TASK_ROOT}"

# Set the Lambda handler (file.function)
CMD ["app.lambda_handler"]